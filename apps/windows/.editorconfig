root = true

# 改行は LF で固定する（リポジトリ直下 .gitattributes の eol=lf と揃える）。
# CRLF が混ざると spec/testdata の JSONL / JSON のパーステストが落ちる。
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets}]
indent_style = space
indent_size = 4

[*.{json,yaml,yml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# 日本語コメント・日本語文字列をそのまま扱う
csharp_style_namespace_declarations = file_scoped:warning
