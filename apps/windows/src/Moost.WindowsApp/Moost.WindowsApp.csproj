<Project Sdk="Microsoft.NET.Sdk">

  <!--
    デスクトップ UI（WPF）。macOS の apps/macos/Sources/MoostApp に対応する。
    トレイ常駐は WinForms の NotifyIcon を interop で使う（追加 NuGet を避ける・ADR-006）。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <!-- 成果物名は Moost.exe（winget の PortableCommandAlias: moost と揃える） -->
    <AssemblyName>Moost</AssemblyName>
    <RootNamespace>Moost.WindowsApp</RootNamespace>

    <!-- exe のアイコン（トレイと同じ素材） -->
    <ApplicationIcon>Assets\moost.ico</ApplicationIcon>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Moost.Core\Moost.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      トレイアイコンは埋め込みリソースにする。単一 exe 配布でも欠けないようにするため
      （Content にして exe の隣に置くと、publish の単一ファイル化で欠ける）。
    -->
    <Resource Include="Assets\moost.ico" />
  </ItemGroup>

  <ItemGroup>
    <!--
      WPF と WinForms を併用すると Application / MessageBox などが暗黙 using で衝突する。
      WinForms の暗黙 using を外し、必要な箇所では using System.Windows.Forms; を明示する。
    -->
    <Using Remove="System.Windows.Forms" />
    <!-- System.Drawing も暗黙 using から外す（Brush / Brushes が WPF と衝突するため） -->
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
