<Window x:Class="Moost.WindowsApp.PopoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Moost"
        Width="570" Height="660"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="{StaticResource ChromeBrush}">
    <!--
        ポップオーバー相当のウィンドウ（macOS の NSPopover の写像・design.md 6 章）。
        中身は**単一画面のステートマシン**（6.1）。画面は PopoverWindow が差し替える。
    -->
    <ContentControl x:Name="ScreenHost" />
</Window>
