<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        デザイン定数（design.md 6.5 の「3 つの数値だけ変えれば全画面に反映される」構造の写像）。
        色・フォントはここだけに置き、画面では StaticResource で参照する。
    -->
    <SolidColorBrush x:Key="ChromeBrush" Color="#FFF4F4F5" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#FFF0F7F6" />
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#FFE0F2F1" />
    <SolidColorBrush x:Key="DividerBrush" Color="#FFE2E2E2" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF009688" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF6B6B6B" />

    <sys:Double x:Key="AppTitleFontSize">15</sys:Double>
    <sys:Double x:Key="AppBodyFontSize">14</sys:Double>
    <sys:Double x:Key="AppCaptionFontSize">11</sys:Double>

    <!-- appHeadline: 画面タイトル -->
    <Style x:Key="AppTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource AppTitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- appBody: 本文・リスト行・入力（全体のデフォルト） -->
    <Style x:Key="AppBodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource AppBodyFontSize}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- appCaption: 補足（macOS は 10pt・Windows はレンダリング差を考慮して 11） -->
    <Style x:Key="AppCaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource AppCaptionFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 入力欄（角丸・薄い枠） -->
    <Style x:Key="AppTextBox" TargetType="TextBox">
        <Setter Property="FontSize" Value="{StaticResource AppBodyFontSize}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主要ボタン（teal の塗り） -->
    <Style x:Key="AppPrimaryButton" TargetType="Button">
        <Setter Property="FontSize" Value="{StaticResource AppBodyFontSize}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="6" Background="{StaticResource AccentBrush}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 副次ボタン（枠線のみ） -->
    <Style x:Key="AppSecondaryButton" TargetType="Button">
        <Setter Property="FontSize" Value="{StaticResource AppCaptionFontSize}" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="5"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 行内のアイコンボタン（ターミナル / コピー / 詳細 / 削除） -->
    <Style x:Key="AppIconButton" TargetType="Button">
        <Setter Property="FontSize" Value="{StaticResource AppBodyFontSize}" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="4" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource RowSelectedBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- フッターのテキストボタン -->
    <Style x:Key="AppFooterButton" TargetType="Button">
        <Setter Property="FontSize" Value="{StaticResource AppCaptionFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- セグメントピッカー（macOS のセグメンテッドコントロールの写像） -->
    <Style x:Key="SegmentButton" TargetType="RadioButton">
        <Setter Property="FontSize" Value="{StaticResource AppCaptionFontSize}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome" CornerRadius="5" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource DividerBrush}" />
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="1" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource RowHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
