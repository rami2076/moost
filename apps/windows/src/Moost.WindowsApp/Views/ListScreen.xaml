<UserControl x:Class="Moost.WindowsApp.Views.ListScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        ルート画面（design.md 6.1 の list）。
        ヘッダーにセグメントピッカー（セッション / メモ / プロジェクト）、
        本文に一覧、フッターに 設定・注意・終了（＋更新ボタン）。
    -->
    <Grid Background="{StaticResource ChromeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="12,10,12,8">
            <DockPanel>
                <TextBlock Text="Moost" Style="{StaticResource AppTitleText}" DockPanel.Dock="Left" />
                <TextBlock x:Name="VersionText" Style="{StaticResource AppCaptionText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </DockPanel>

            <!-- セグメントピッカー -->
            <Border Margin="0,8,0,0" CornerRadius="7" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" Padding="2">
                <UniformGrid Rows="1">
                    <RadioButton x:Name="SessionsTab" Content="セッション" Style="{StaticResource SegmentButton}"
                                 GroupName="segments" IsChecked="True" Checked="OnSegmentChanged" />
                    <RadioButton x:Name="MemosTab" Content="メモ" Style="{StaticResource SegmentButton}"
                                 GroupName="segments" Checked="OnSegmentChanged" />
                    <RadioButton x:Name="ProjectsTab" Content="プロジェクト" Style="{StaticResource SegmentButton}"
                                 GroupName="segments" Checked="OnSegmentChanged" />
                </UniformGrid>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="8,0,8,0" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="RowsHost" />
        </ScrollViewer>

        <Border Grid.Row="2" Margin="0,6,0,0" Padding="10,6" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="設定" Style="{StaticResource AppFooterButton}" Click="OnSettings" />
                    <Button Content="注意" Style="{StaticResource AppFooterButton}" Click="OnNotes" />
                    <Button Content="終了" Style="{StaticResource AppFooterButton}" Click="OnQuit" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock x:Name="UpdateText" Style="{StaticResource AppCaptionText}"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button x:Name="UpdateButton" Content="更新" Style="{StaticResource AppSecondaryButton}"
                            Visibility="Collapsed" Click="OnUpdate" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
