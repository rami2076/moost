<UserControl x:Class="Moost.WindowsApp.Views.MemoFormScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- メモ登録・編集フォーム（design.md 6.1 の newMemo / editMemo） -->
    <Grid Background="{StaticResource ChromeBrush}" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Button Content="← 戻る" Style="{StaticResource AppFooterButton}" DockPanel.Dock="Left" Click="OnBack" />
            <TextBlock x:Name="TitleText" Style="{StaticResource AppTitleText}" HorizontalAlignment="Center" />
        </DockPanel>

        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <TextBlock Text="セッション" Style="{StaticResource AppCaptionText}" />
            <TextBlock x:Name="SessionText" Style="{StaticResource AppBodyText}" Margin="0,2,0,10" TextWrapping="Wrap" />

            <TextBlock Text="表題" Style="{StaticResource AppCaptionText}" />
            <TextBox x:Name="TitleBox" Style="{StaticResource AppTextBox}" Margin="0,2,0,10" />

            <TextBlock Text="タグ（カンマ区切り）" Style="{StaticResource AppCaptionText}" />
            <TextBox x:Name="TagsBox" Style="{StaticResource AppTextBox}" Margin="0,2,0,10" />

            <TextBlock Text="本文" Style="{StaticResource AppCaptionText}" />
            <TextBox x:Name="BodyBox" Style="{StaticResource AppTextBox}" Height="220"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,2,0,0" />
        </StackPanel>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <Button Content="保存" Style="{StaticResource AppPrimaryButton}" DockPanel.Dock="Right" Click="OnSave" />
            <TextBlock x:Name="StatusText" Style="{StaticResource AppCaptionText}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</UserControl>
