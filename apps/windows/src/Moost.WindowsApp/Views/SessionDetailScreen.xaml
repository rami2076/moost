<UserControl x:Class="Moost.WindowsApp.Views.SessionDetailScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- セッション詳細（design.md 6.1 の sessionDetail / summary） -->
    <Grid Background="{StaticResource ChromeBrush}" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Button Content="← 戻る" Style="{StaticResource AppFooterButton}" DockPanel.Dock="Left" Click="OnBack" />
            <TextBlock Text="セッション詳細" Style="{StaticResource AppTitleText}" HorizontalAlignment="Center" />
        </DockPanel>

        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <TextBlock x:Name="TitleText" Style="{StaticResource AppBodyText}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="MetaText" Style="{StaticResource AppCaptionText}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <WrapPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="ラリー数" Style="{StaticResource AppCaptionText}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <Button Content="−" Style="{StaticResource AppSecondaryButton}" Click="OnRallyMinus" />
            <TextBlock x:Name="RallyText" Style="{StaticResource AppBodyText}" VerticalAlignment="Center" Margin="8,0" />
            <Button Content="＋" Style="{StaticResource AppSecondaryButton}" Click="OnRallyPlus" Margin="0,0,12,0" />
            <Button Content="直近を要約" Style="{StaticResource AppPrimaryButton}" Margin="0,0,6,0" Click="OnSummarizeRecent" />
            <Button Content="全体を要約" Style="{StaticResource AppSecondaryButton}" Click="OnSummarizeFull" />
        </WrapPanel>

        <TextBox x:Name="SummaryBox" Grid.Row="3" Margin="0,10,0,0" Style="{StaticResource AppTextBox}"
                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Background="{StaticResource SurfaceBrush}" />

        <DockPanel Grid.Row="4" Margin="0,10,0,0">
            <Button Content="メモを登録" Style="{StaticResource AppPrimaryButton}" DockPanel.Dock="Right" Click="OnMemo" />
            <TextBlock x:Name="StatusText" Style="{StaticResource AppCaptionText}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</UserControl>
