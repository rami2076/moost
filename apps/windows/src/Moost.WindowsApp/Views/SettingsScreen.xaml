<UserControl x:Class="Moost.WindowsApp.Views.SettingsScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 設定（design.md 6.6） -->
    <Grid Background="{StaticResource ChromeBrush}" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Button Content="← 戻る" Style="{StaticResource AppFooterButton}" DockPanel.Dock="Left" Click="OnBack" />
            <TextBlock Text="設定" Style="{StaticResource AppTitleText}" HorizontalAlignment="Center" />
        </DockPanel>

        <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="復帰先ターミナル（wt.exe / powershell.exe）" Style="{StaticResource AppCaptionText}" />
                <TextBox x:Name="TerminalAppBox" Style="{StaticResource AppTextBox}" Margin="0,2,0,10" />

                <TextBlock Text="直近セッションの表示件数（5〜100）" Style="{StaticResource AppCaptionText}" />
                <TextBox x:Name="LimitBox" Style="{StaticResource AppTextBox}" Margin="0,2,0,10" />

                <TextBlock Text="claude コマンドのパス（空なら自動検出・要約専用）" Style="{StaticResource AppCaptionText}" />
                <TextBox x:Name="ClaudePathBox" Style="{StaticResource AppTextBox}" Margin="0,2,0,10" />

                <TextBlock Text="要約のラリー数（1〜20）" Style="{StaticResource AppCaptionText}" />
                <TextBox x:Name="RallyBox" Style="{StaticResource AppTextBox}" Margin="0,2,0,10" />

                <TextBlock Text="pi プロバイダー名（空なら pi の既定）" Style="{StaticResource AppCaptionText}" />
                <TextBox x:Name="PiProviderBox" Style="{StaticResource AppTextBox}" Margin="0,2,0,10" />

                <TextBlock Text="pi モデル名（空なら pi の既定）" Style="{StaticResource AppCaptionText}" />
                <TextBox x:Name="PiModelBox" Style="{StaticResource AppTextBox}" Margin="0,2,0,10" />

                <CheckBox x:Name="CopyAnimationBox" Content="コピー成功のアニメーション"
                          FontSize="{StaticResource AppBodyFontSize}" Margin="0,0,0,6" />
                <CheckBox x:Name="AutoStartBox" Content="ログイン時に自動起動"
                          FontSize="{StaticResource AppBodyFontSize}" Margin="0,0,0,6" />
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <Button Content="保存" Style="{StaticResource AppPrimaryButton}" DockPanel.Dock="Right" Click="OnSave" />
            <TextBlock x:Name="StatusText" Style="{StaticResource AppCaptionText}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</UserControl>
