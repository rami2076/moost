<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Moost.Core のテスト（xUnit）。
    Fixture は spec/testdata をコピーせず、リポジトリ直下の正をそのまま読む（SpecPaths）。
    バージョン指定は Directory.Packages.props（中央管理）に集約する。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Moost.Core.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Moost.Core\Moost.Core.csproj" />
  </ItemGroup>

</Project>
